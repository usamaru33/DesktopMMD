{
  "name": "desktop-mmd",
  "productName": "DesktopMMD",
  "version": "0.3.4",
  "description": "Windowsデスクトップに常駐し、音声とテキストで対話・作業代行を行うMMDアシスタント",
  "private": true,
  "main": "out/main/index.js",
  "author": "usamaru33",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fake": "cross-env MMD_FAKE_LLM=1 electron-vite dev",
    "dev:shot": "cross-env MMD_FAKE_LLM=1 MMD_SHOT=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:voicevox": "cross-env MMD_IT_VOICEVOX=1 vitest run tests/integration/voicevox.test.ts",
    "test:sidecar": "cross-env MMD_IT_SIDECAR=1 vitest run tests/integration/sidecar.test.ts",
    "coverage": "vitest run --coverage",
    "eval:llm": "tsx --tsconfig tsconfig.node.json scripts/eval-llm.ts",
    "latency-report": "tsx --tsconfig tsconfig.node.json scripts/latency-report.ts",
    "sidecar:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-sidecar.ps1",
    "postinstall": "node scripts/copy-ammo.mjs",
    "dist": "node scripts/build-readme.mjs && electron-vite build && electron-builder --win --config electron-builder.yml",
    "voicevox": "powershell -ExecutionPolicy Bypass -File scripts/start-voicevox.ps1",
    "sidecar:build": "cd sidecar && .venv\\Scripts\\python.exe -m pip install pyinstaller && .venv\\Scripts\\python.exe -m PyInstaller --noconfirm sidecar.spec"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.16",
    "get-windows": "^9.3.0",
    "ical.js": "^2.2.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "three": "0.170.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/three": "0.170.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "tar": "^7.5.21"
  }
}
